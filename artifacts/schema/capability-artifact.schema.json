{
  "$ref": "#/definitions/CapabilityArtifact",
  "definitions": {
    "CapabilityArtifact": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.1"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "target": {
          "type": "object",
          "properties": {
            "appId": {
              "type": "string"
            },
            "entryUrl": {
              "type": "string"
            }
          },
          "required": [
            "appId",
            "entryUrl"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "description": {
                "type": "string"
              },
              "required": {
                "type": "boolean",
                "default": true
              },
              "sensitive": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "name",
              "type",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "type",
              "description"
            ],
            "additionalProperties": false
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "navigate",
                  "click",
                  "fill",
                  "select",
                  "check",
                  "press_key",
                  "wait_for",
                  "extract"
                ]
              },
              "description": {
                "type": "string"
              },
              "locator": {
                "type": "object",
                "properties": {
                  "primary": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "strategy": {
                            "type": "string",
                            "const": "role"
                          },
                          "role": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "nameMatch": {
                            "type": "string",
                            "enum": [
                              "exact",
                              "contains"
                            ],
                            "default": "exact"
                          },
                          "nth": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 0
                          }
                        },
                        "required": [
                          "strategy",
                          "role",
                          "name"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "strategy": {
                            "type": "string",
                            "const": "label"
                          },
                          "label": {
                            "type": "string"
                          },
                          "nth": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 0
                          }
                        },
                        "required": [
                          "strategy",
                          "label"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "strategy": {
                            "type": "string",
                            "const": "text"
                          },
                          "text": {
                            "type": "string"
                          },
                          "exact": {
                            "type": "boolean",
                            "default": false
                          },
                          "nth": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 0
                          }
                        },
                        "required": [
                          "strategy",
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "strategy": {
                            "type": "string",
                            "const": "css"
                          },
                          "selector": {
                            "type": "string"
                          },
                          "nth": {
                            "type": "integer",
                            "minimum": 0,
                            "default": 0
                          }
                        },
                        "required": [
                          "strategy",
                          "selector"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "strategy": {
                            "type": "string",
                            "const": "testid"
                          },
                          "testId": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "strategy",
                          "testId"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "fallbacks": {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/CapabilityArtifact/properties/steps/items/properties/locator/properties/primary"
                    },
                    "default": []
                  },
                  "reasoning": {
                    "type": "string"
                  }
                },
                "required": [
                  "primary"
                ],
                "additionalProperties": false
              },
              "value": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "literal"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "param"
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "extractTo": {
                "type": "string"
              },
              "url": {
                "$ref": "#/definitions/CapabilityArtifact/properties/steps/items/properties/value"
              },
              "checkpoint": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "urlContains": {
                    "type": "string"
                  },
                  "textContains": {
                    "type": "string"
                  },
                  "locatorVisible": {
                    "$ref": "#/definitions/CapabilityArtifact/properties/steps/items/properties/locator"
                  }
                },
                "required": [
                  "description"
                ],
                "additionalProperties": false
              },
              "effect": {
                "type": "string",
                "enum": [
                  "read",
                  "state_changing",
                  "irreversible"
                ],
                "default": "read"
              }
            },
            "required": [
              "id",
              "action",
              "description"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "successCheckpoint": {
          "$ref": "#/definitions/CapabilityArtifact/properties/steps/items/properties/checkpoint"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "name",
        "version",
        "description",
        "goal",
        "createdAt",
        "target",
        "inputs",
        "outputs",
        "steps",
        "successCheckpoint"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}