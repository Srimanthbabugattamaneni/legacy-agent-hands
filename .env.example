# Everything in this project runs locally. There is no API key to set: the
# discovery run uses an open-weight model served by Ollama on this machine,
# and replay never calls a model at all.
#
# All optional — shown with their defaults.

# LLM_PROVIDER=ollama
# MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434

# MOCK_BANK_PORT=4000
# OPERATOR_PORT=4100

# Discovery runs with a visible browser by default so you can watch it, and
# take over the same window if it escalates. Set true for unattended runs.
# HEADLESS=false

# How long a run waits for a human to answer an escalation before giving up.
# ESCALATION_TIMEOUT_MS=600000
